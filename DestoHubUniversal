local function newSlider(parent, label, min, max, default, order, onChange)
    local row = Instance.new("Frame", parent)
    row.Size=UDim2.new(1,0,0,54); row.BackgroundColor3=T.PANEL
    row.BorderSizePixel=0; row.LayoutOrder=order
    Instance.new("UICorner", row).CornerRadius=UDim.new(0,8)
    Instance.new("UIStroke", row).Color=Color3.fromRGB(55,44,8)
    local lbl = Instance.new("TextLabel", row)
    lbl.Font=Enum.Font.GothamBold; lbl.TextSize=11; lbl.TextColor3=T.TEXT
    lbl.BackgroundTransparency=1; lbl.Size=UDim2.new(0.6,0,0,18)
    lbl.Position=UDim2.new(0,10,0,5); lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.Text=label
    local valLbl = Instance.new("TextLabel", row)
    valLbl.Font=Enum.Font.GothamBold; valLbl.TextSize=11; valLbl.TextColor3=T.GLOW
    valLbl.BackgroundTransparency=1; valLbl.Size=UDim2.new(0.35,0,0,18)
    valLbl.Position=UDim2.new(0.65,0,0,5); valLbl.TextXAlignment=Enum.TextXAlignment.Right
    valLbl.Text=tostring(default)
    local track = Instance.new("Frame", row)
    track.Size=UDim2.new(1,-20,0,6); track.Position=UDim2.new(0,10,0,32)
    track.BackgroundColor3=T.TOFF; track.BorderSizePixel=0
    Instance.new("UICorner", track).CornerRadius=UDim.new(1,0)
    local fill = Instance.new("Frame", track)
    fill.Size=UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3=T.ACCENT; fill.BorderSizePixel=0
    Instance.new("UICorner", fill).CornerRadius=UDim.new(1,0)
    local knob = Instance.new("Frame", track)
    knob.Size=UDim2.new(0,14,0,14); knob.AnchorPoint=Vector2.new(0.5,0.5)
    knob.Position=UDim2.new((default-min)/(max-min),0,0.5,0)
    knob.BackgroundColor3=T.WHITE; knob.BorderSizePixel=0
    Instance.new("UICorner", knob).CornerRadius=UDim.new(1,0)
    local dragging = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max-min)*rel)
        fill.Size=UDim2.new(rel,0,1,0)
        knob.Position=UDim2.new(rel,0,0.5,0)
        valLbl.Text=tostring(val)
        onChange(val)
    end
    knob.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            update(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then update(i.Position.X) end end)
end

local function buildPlayerList(parent, startOrder, onSelect)
    local listFrame = Instance.new("Frame", parent)
    listFrame.Size=UDim2.new(1,0,0,0); listFrame.AutomaticSize=Enum.AutomaticSize.Y
    listFrame.BackgroundTransparency=1; listFrame.LayoutOrder=startOrder
    local lay = Instance.new("UIListLayout", listFrame)
    lay.Padding=UDim.new(0,4); lay.SortOrder=Enum.SortOrder.LayoutOrder
    local rowCache = {}
    local function refresh()
        for _,r in pairs(rowCache) do r:Destroy() end; rowCache={}
        local i=0
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp then
                i=i+1
                local row = Instance.new("Frame", listFrame)
                row.Size=UDim2.new(1,0,0,28); row.BackgroundColor3=T.PANEL2
                row.BorderSizePixel=0; row.LayoutOrder=i
                Instance.new("UICorner", row).CornerRadius=UDim.new(0,6)
                local name = Instance.new("TextLabel", row)
                name.Text=p.Name; name.Font=Enum.Font.GothamSemibold; name.TextSize=10
                name.TextColor3=T.TEXT; name.BackgroundTransparency=1
                name.Size=UDim2.new(1,-70,1,0); name.Position=UDim2.new(0,10,0,0)
                name.TextXAlignment=Enum.TextXAlignment.Left
                local selfBtn = Instance.new("TextButton", row)
                selfBtn.Text="SELECT"; selfBtn.Font=Enum.Font.GothamBold; selfBtn.TextSize=9
                selfBtn.BackgroundColor3=T.TON; selfBtn.TextColor3=T.BG
                selfBtn.Size=UDim2.new(0,50,0,18); selfBtn.Position=UDim2.new(1,-56,0.5,-9)
                selfBtn.BorderSizePixel=0
                Instance.new("UICorner", selfBtn).CornerRadius=UDim.new(0,4)
                selfBtn.MouseButton1Click:Connect(function() onSelect(p) end)
                table.insert(rowCache, row)
            end
        end
    end
    refresh()
    Players.PlayerAdded:Connect(refresh)
    Players.PlayerRemoving:Connect(function() task.wait(0.1); refresh() end)
    return listFrame
end

