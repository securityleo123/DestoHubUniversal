local tabs = {}
local function newTab(name, icon, order)
    local btn = Instance.new("TextButton", TBar)
    btn.Text=icon.." "..name; btn.Font=Enum.Font.GothamSemibold; btn.TextSize=9
    btn.TextColor3=T.SUBTEXT; btn.BackgroundColor3=T.PANEL2
    btn.BackgroundTransparency=1; btn.Size=UDim2.new(0,60,1,0)
    btn.AutoButtonColor=false; btn.LayoutOrder=order
    Instance.new("UICorner", btn).CornerRadius=UDim.new(0,6)

    local ind = Instance.new("Frame", btn)
    ind.Size=UDim2.new(0.7,0,0,2); ind.Position=UDim2.new(0.15,0,1,-2)
    ind.BackgroundColor3=T.ACCENT; ind.BorderSizePixel=0; ind.BackgroundTransparency=1
    Instance.new("UICorner", ind).CornerRadius=UDim.new(1,0)

    local frame = Instance.new("ScrollingFrame", Content)
    frame.Size=UDim2.new(1,0,1,0); frame.BackgroundTransparency=1
    frame.BorderSizePixel=0; frame.ScrollBarThickness=2
    frame.ScrollBarImageColor3=T.ACCENT; frame.CanvasSize=UDim2.new(0,0,0,0)
    frame.AutomaticCanvasSize=Enum.AutomaticSize.Y; frame.Visible=false
    local lay = Instance.new("UIListLayout", frame)
    lay.Padding=UDim.new(0,5); lay.SortOrder=Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", frame); pad.PaddingTop=UDim.new(0,3)

    tabs[name] = {btn=btn, frame=frame, ind=ind}

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.frame.Visible=false
            TweenService:Create(t.btn,TweenInfo.new(0.15),
                {TextColor3=T.SUBTEXT, BackgroundTransparency=1}):Play()
            TweenService:Create(t.ind,TweenInfo.new(0.15),
                {BackgroundTransparency=1}):Play()
        end
        frame.Visible=true
        TweenService:Create(btn,TweenInfo.new(0.15),
            {TextColor3=T.GLOW, BackgroundTransparency=0}):Play()
        TweenService:Create(ind,TweenInfo.new(0.15),
            {BackgroundTransparency=0}):Play()
    end)
    return frame
end

